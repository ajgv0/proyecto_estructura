    public static class LogoPanel extends JPanel {
        private int size;

        public LogoPanel(int size) {
            this.size = size;
            setPreferredSize(new Dimension(size, size));
            setOpaque(false);
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g.create();
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();

            // Dibujar círculo orbital de fondo
            g2d.setColor(ACCENT_BLUE);
            g2d.setStroke(new BasicStroke(3));
            g2d.drawOval(5, height / 4, width - 10, height / 2);

            // Dibujar 'G' icónica estilizada
            GradientPaint gradiente = new GradientPaint(0, 0, ACCENT_BLUE, width, height, ACCENT_PURPLE);
            g2d.setPaint(gradiente);
            g2d.setStroke(new BasicStroke(8, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND));
            g2d.drawArc(10, 10, width - 20, height - 20, 45, 270);
            g2d.drawLine(width / 2, height / 2, width - 15, height / 2);

            // Dibujar Gamepad pequeño al centro
            g2d.setColor(TEXT_LIGHT);
            g2d.fillRect(width / 2 - 10, height / 2 - 5, 20, 10);

            g2d.dispose();
        }
    }

