        // =========================================================================
        // 7. PESTAÑA 1: PILA (BUGS CRÍTICOS)
        // =========================================================================
        private JPanel crearPanelBugs() {
            JPanel panel = new JPanel(null);
            panel.setBackground(BG_DARK);

            JLabel lblTitle = new JLabel("Administración de Bugs Críticos (Estructura LIFO)");
            lblTitle.setBounds(20, 15, 450, 25);
            lblTitle.setForeground(ACCENT_BLUE);
            lblTitle.setFont(FONT_TITLE);
            panel.add(lblTitle);

            // Campos de Formulario
            JLabel lblMod = new JLabel("Módulo:");
            lblMod.setBounds(20, 50, 80, 20);
            lblMod.setForeground(TEXT_LIGHT);
            panel.add(lblMod);

            JTextField txtModulo = new JTextField();
            txtModulo.setBounds(20, 70, 150, 25);
            txtModulo.setBackground(PANEL_DARK);
            txtModulo.setForeground(TEXT_LIGHT);
            panel.add(txtModulo);

            JLabel lblSev = new JLabel("Severidad:");
            lblSev.setBounds(180, 50, 80, 20);
            lblSev.setForeground(TEXT_LIGHT);
            panel.add(lblSev);

            JComboBox<String> cbSeveridad = new JComboBox<>(new String[]{"Baja", "Media", "Alta", "Crítica"});
            cbSeveridad.setBounds(180, 70, 120, 25);
            panel.add(cbSeveridad);

            JLabel lblDesc = new JLabel("Descripción:");
            lblDesc.setBounds(310, 50, 100, 20);
            lblDesc.setForeground(TEXT_LIGHT);
            panel.add(lblDesc);

            JTextField txtDesc = new JTextField();
            txtDesc.setBounds(310, 70, 250, 25);
            txtDesc.setBackground(PANEL_DARK);
            txtDesc.setForeground(TEXT_LIGHT);
            panel.add(txtDesc);

            // Lista Visual de Pila
            JList<String> listBugs = new JList<>(modelBugsList);
            listBugs.setBackground(PANEL_DARK);
            listBugs.setForeground(TEXT_LIGHT);
            JScrollPane scroll = new JScrollPane(listBugs);
            scroll.setBounds(20, 110, 540, 320);
            panel.add(scroll);

            // Botones de Acción (PUSH, POP, PEEK)
            JButton btnPush = new JButton("Registrar Bug (PUSH)");
            btnPush.setBounds(580, 110, 260, 35);
            btnPush.setBackground(ACCENT_BLUE);
            btnPush.setForeground(Color.WHITE);
            btnPush.addActionListener(e -> {
                String mod = txtModulo.getText().trim();
                String desc = txtDesc.getText().trim();
                String sev = (String) cbSeveridad.getSelectedItem();

                if (mod.isEmpty() || desc.isEmpty()) {
                    HUDDialogs.mostrarAdvertencia(this, "Complete el módulo y la descripción del error.", "Atención");
                    return;
                }

                contadorBugs++;
                BugItem nuevoBug = new BugItem("BUG-0" + contadorBugs, mod, sev, desc);
                pilaBugs.push(nuevoBug);
                modelBugsList.add(0, nuevoBug.toString()); // Visualmente arriba (LIFO)

                txtModulo.setText("");
                txtDesc.setText("");
                HUDDialogs.mostrarInfo(this, "Bug registrado exitosamente en la cima de la Pila.", "Éxito (PUSH)");
            });
            panel.add(btnPush);

            JButton btnPop = new JButton("Resolver Reciente (POP)");
            btnPop.setBounds(580, 160, 260, 35);
            btnPop.setBackground(ACCENT_PURPLE);
            btnPop.setForeground(Color.WHITE);
            btnPop.addActionListener(e -> {
                if (pilaBugs.isEmpty()) {
                    HUDDialogs.mostrarAdvertencia(this, "No hay bugs pendientes en la Pila.", "Pila Vacía");
                    return;
                }

                BugItem tope = pilaBugs.peek();
                boolean confirmar = HUDDialogs.confirmarAccion(
                        this, 
                        "¿Desea marcar como RESUELTO el siguiente bug del tope?\n\n" + tope.toString(), 
                        "Confirmar Resolver Bug (POP)"
                );

                if (confirmar) {
                    pilaBugs.pop();
                    modelBugsList.remove(0);
                    HUDDialogs.mostrarInfo(this, "El bug fue retirado exitosamente de la Pila.", "Bug Resuelto");
                }
            });
            panel.add(btnPop);

            JButton btnPeek = new JButton("Ver Tope (PEEK)");
            btnPeek.setBounds(580, 210, 260, 35);
            btnPeek.setBackground(PANEL_DARK);
            btnPeek.setForeground(TEXT_LIGHT);
            btnPeek.addActionListener(e -> {
                if (pilaBugs.isEmpty()) {
                    HUDDialogs.mostrarInfo(this, "La Pila se encuentra actualmente vacía.", "Consulta PEEK");
                } else {
                    HUDDialogs.mostrarInfo(this, "Bug actualmente en la CIMA (Tope):\n\n" + pilaBugs.peek().toString(), "Consulta PEEK");
                }
            });
            panel.add(btnPeek);

            return panel;
        }

