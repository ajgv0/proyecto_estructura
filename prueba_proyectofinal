            JLabel lblTitle = new JLabel("Cola de Procesamiento de Assets (Estructura FIFO)");
            lblTitle.setBounds(20, 15, 450, 25);
            lblTitle.setForeground(ACCENT_BLUE);
            lblTitle.setFont(FONT_TITLE);
            panel.add(lblTitle);

            // Campos Formulario
            JLabel lblNom = new JLabel("Nombre Asset:");
            lblNom.setBounds(20, 50, 100, 20);
            lblNom.setForeground(TEXT_LIGHT);
            panel.add(lblNom);

            JTextField txtNombre = new JTextField();
            txtNombre.setBounds(20, 70, 160, 25);
            txtNombre.setBackground(PANEL_DARK);
            txtNombre.setForeground(TEXT_LIGHT);
            panel.add(txtNombre);

            JLabel lblTiem = new JLabel("Tiempo (Min):");
            lblTiem.setBounds(190, 50, 90, 20);
            lblTiem.setForeground(TEXT_LIGHT);
            panel.add(lblTiem);

            JSpinner spTiempo = new JSpinner(new SpinnerNumberModel(10, 1, 180, 5));
            spTiempo.setBounds(190, 70, 80, 25);
            panel.add(spTiempo);

            JLabel lblForm = new JLabel("Formato:");
            lblForm.setBounds(280, 50, 80, 20);
            lblForm.setForeground(TEXT_LIGHT);
            panel.add(lblForm);

            JComboBox<String> cbFormato = new JComboBox<>(new String[]{"EXR", "PNG_32", "FBX", "OBJ"});
            cbFormato.setBounds(280, 70, 100, 25);
            panel.add(cbFormato);

            // Lista Visual de Cola
            JList<String> listRender = new JList<>(modelRenderList);
            listRender.setBackground(PANEL_DARK);
            listRender.setForeground(TEXT_LIGHT);
            JScrollPane scroll = new JScrollPane(listRender);
            scroll.setBounds(20, 110, 540, 320);
            panel.add(scroll);

            // Botones de Operación (ENQUEUE, DEQUEUE, FRONT)
            JButton btnEnqueue = new JButton("Añadir a Cola (ENQUEUE)");
            btnEnqueue.setBounds(580, 110, 260, 35);
            btnEnqueue.setBackground(ACCENT_BLUE);
            btnEnqueue.setForeground(Color.WHITE);
            btnEnqueue.addActionListener(e -> {
                String nom = txtNombre.getText().trim();
                int tiempo = (int) spTiempo.getValue();
                String form = (String) cbFormato.getSelectedItem();

                if (nom.isEmpty()) {
                    HUDDialogs.mostrarAdvertencia(this, "Ingrese el nombre del asset a renderizar.", "Campo Requerido");
                    return;
                }

                contadorAssets++;
                RenderAsset nuevoAsset = new RenderAsset("RND-0" + contadorAssets, nom, tiempo, form);
                colaRender.add(nuevoAsset);
                modelRenderList.addElement(nuevoAsset.toString());

                txtNombre.setText("");
                HUDDialogs.mostrarInfo(this, "Asset encolado correctamente en el turno #" + colaRender.size(), "Éxito (ENQUEUE)");
            });
            panel.add(btnEnqueue);

            JButton btnDequeue = new JButton("Procesar Siguiente (DEQUEUE)");
            btnDequeue.setBounds(580, 160, 260, 35);
            btnDequeue.setBackground(ACCENT_PURPLE);
            btnDequeue.setForeground(Color.WHITE);
            btnDequeue.addActionListener(e -> {
                if (colaRender.isEmpty()) {
                    HUDDialogs.mostrarAdvertencia(this, "La cola de renderizado está vacía.", "Cola Vacía");
                    return;
                }

                RenderAsset frente = colaRender.peek();
                boolean confirmar = HUDDialogs.confirmarAccion(
                        this,
                        "¿Iniciar el procesamiento de render para el asset del FRENTE?\n\n" + frente.toString(),
                        "Confirmar Render (DEQUEUE)"
                );

                if (confirmar) {
                    colaRender.poll();
                    modelRenderList.remove(0);
                    HUDDialogs.mostrarInfo(this, "Asset procesado y retirado del frente de la cola.", "Render Completado");
                }
            });
            panel.add(btnDequeue);

            JButton btnFront = new JButton("Ver Siguiente (FRONT / PEEK)");
            btnFront.setBounds(580, 210, 260, 35);
            btnFront.setBackground(PANEL_DARK);
            btnFront.setForeground(TEXT_LIGHT);
            btnFront.addActionListener(e -> {
                if (colaRender.isEmpty()) {
                    HUDDialogs.mostrarInfo(this, "No hay tareas en la cola.", "Consulta FRONT");
                } else {
                    int tiempoTotal = colaRender.stream().mapToInt(RenderAsset::getTiempoMinutos).sum();
                    HUDDialogs.mostrarInfo(this, "Siguiente tarea en la cabeza de la COLA:\n\n" + colaRender.peek().toString() + 
                            "\n\nTiempo estimado total acumulado en cola: " + tiempoTotal + " minutos.", "Consulta FRONT");
                }
            });
            panel.add(btnFront);

            return panel;
        }

        // =========================================================================
        // 9. PESTAÑA 3: LISTA (CATÁLOGO GENERAL - CRUD COMPLETO)
        // =========================================================================
        private JPanel crearPanelCatalogo() {
            JPanel panel = new JPanel(null);
            panel.setBackground(BG_DARK);

            JLabel lblTitle = new JLabel("Catálogo General del Juego (Estructura ArrayList / Tabla CRUD)");
            lblTitle.setBounds(20, 15, 500, 25);
            lblTitle.setForeground(ACCENT_BLUE);
            lblTitle.setFont(FONT_TITLE);
            panel.add(lblTitle);

            // Tabla de Datos
            String[] columnas = {"ID", "Nombre Entidad", "Tipo", "Nivel/Potencia", "Activo"};
            modelTableCatalogo = new DefaultTableModel(columnas, 0) {
                @Override
                public boolean isCellEditable(int row, int column) {
                    return false; // Tabla no editable directamente en celdas
                }
            };

            JTable tabla = new JTable(modelTableCatalogo);
            tabla.setBackground(PANEL_DARK);
            tabla.setForeground(TEXT_LIGHT);
            tabla.setGridColor(BG_DARK);
            JScrollPane scroll = new JScrollPane(tabla);
            scroll.setBounds(20, 50, 560, 380);
            panel.add(scroll);

            // Botonera Lateral CRUD con JOptionPane
            JButton btnAgregar = new JButton("Añadir Entidad (CREATE)");
            btnAgregar.setBounds(600, 50, 240, 35);
            btnAgregar.setBackground(ACCENT_BLUE);
            btnAgregar.setForeground(Color.WHITE);
            btnAgregar.addActionListener(e -> {
                String nom = HUDDialogs.pedirTexto(this, "Ingrese el nombre de la nueva entidad:", "Agregar al Catálogo", "Nuevo_Objeto");
                if (nom != null && !nom.trim().isEmpty()) {
                    String[] tipos = {"Personaje", "Objeto", "Habilidad", "Escenario"};
                    int opTipo = HUDDialogs.seleccionarOpcion(this, "Seleccione el tipo de elemento:", "Tipo de Entidad", tipos);
                    if (opTipo != -1) {
                        contadorCatalogo++;
                        ElementoCatalogo elem = new ElementoCatalogo("CAT-0" + contadorCatalogo, nom, tipos[opTipo], 1, true);
                        listaCatalogo.add(elem);
                        modelTableCatalogo.addRow(new Object[]{elem.getId(), elem.getNombre(), elem.getTipo(), elem.getNivel(), "Sí"});
                        HUDDialogs.mostrarInfo(this, "Entidad agregada exitosamente al catálogo.", "Éxito");
                    }
                }
            });
            panel.add(btnAgregar);

            JButton btnEditar = new JButton("Modificar (UPDATE)");
            btnEditar.setBounds(600, 100, 240, 35);
            btnEditar.setBackground(ACCENT_PURPLE);
            btnEditar.setForeground(Color.WHITE);
            btnEditar.addActionListener(e -> {
                int fila = tabla.getSelectedRow();
                if (fila == -1) {
                    HUDDialogs.mostrarAdvertencia(this, "Seleccione una fila de la tabla para editar.", "Selección Requerida");
                    return;
                }

                ElementoCatalogo elem = listaCatalogo.get(fila);
                String nuevoNom = HUDDialogs.pedirTexto(this, "Modifique el nombre de la entidad:", "Editar Entidad", elem.getNombre());

                if (nuevoNom != null && !nuevoNom.trim().isEmpty()) {
                    elem.setNombre(nuevoNom);
                    modelTableCatalogo.setValueAt(nuevoNom, fila, 1);
                    HUDDialogs.mostrarInfo(this, "Registro actualizado correctamente.", "Actualización Guardada");
                }
            });
            panel.add(btnEditar);

            JButton btnEliminar = new JButton("Eliminar (DELETE)");
            btnEliminar.setBounds(600, 150, 240, 35);
            btnEliminar.setBackground(ACCENT_RED);
            btnEliminar.setForeground(Color.WHITE);
            btnEliminar.addActionListener(e -> {
                int fila = tabla.getSelectedRow();
                if (fila == -1) {
                    HUDDialogs.mostrarAdvertencia(this, "Seleccione un elemento de la tabla para eliminar.", "Atención");
                    return;
                }

                ElementoCatalogo elem = listaCatalogo.get(fila);
                boolean conf = HUDDialogs.confirmarAccion(
                        this,
                        "¿Está seguro de eliminar de forma permanente la entidad:\n" + elem.getNombre() + " (" + elem.getId() + ")?",
                        "Confirmar Eliminación"
                );

                if (conf) {
                    listaCatalogo.remove(fila);
                    modelTableCatalogo.removeRow(fila);
                    HUDDialogs.mostrarInfo(this, "Entidad eliminada de la lista.", "Registro Eliminado");
                }
            });
            panel.add(btnEliminar);

            JButton btnBuscar = new JButton("Buscar Elemento (READ)");
            btnBuscar.setBounds(600, 200, 240, 35);
            btnBuscar.setBackground(PANEL_DARK);
            btnBuscar.setForeground(TEXT_LIGHT);
            btnBuscar.addActionListener(e -> {
                String busqueda = HUDDialogs.pedirTexto(this, "Ingrese el nombre o ID a buscar:", "Buscar en Catálogo", "");
                if (busqueda != null && !busqueda.trim().isEmpty()) {
                    boolean encontrado = false;
                    for (ElementoCatalogo item : listaCatalogo) {
                        if (item.getNombre().equalsIgnoreCase(busqueda) || item.getId().equalsIgnoreCase(busqueda)) {
                            HUDDialogs.mostrarInfo(this, "¡Elemento Encontrado!\n\n" + item.toString(), "Resultado de Búsqueda");
                            encontrado = true;
                            break;
                        }
                    }
                    if (!encontrado) {
                        HUDDialogs.mostrarAdvertencia(this, "No se encontró ningún elemento con ese nombre o ID.", "Sin Resultados");
                    }
                }
            });
            panel.add(btnBuscar);

            return panel;
        }
    }
