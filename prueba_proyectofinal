    // Modelo para Pila (Bugs)
    public static class BugItem {
        private String id;
        private String modulo;
        private String severidad;
        private String descripcion;

        public BugItem(String id, String modulo, String severidad, String descripcion) {
            this.id = id;
            this.modulo = modulo;
            this.severidad = severidad;
            this.descripcion = descripcion;
        }

        public String getId() { return id; }
        public String getModulo() { return modulo; }
        public String getSeveridad() { return severidad; }
        public String getDescripcion() { return descripcion; }

        @Override
        public String toString() {
            return "[" + id + "] Modulo: " + modulo + " | Severidad: " + severidad + " | " + descripcion;
        }
    }

    // Modelo para Cola (Assets Render)
    public static class RenderAsset {
        private String id;
        private String nombreAsset;
        private int tiempoMinutos;
        private String formato;

        public RenderAsset(String id, String nombreAsset, int tiempoMinutos, String formato) {
            this.id = id;
            this.nombreAsset = nombreAsset;
            this.tiempoMinutos = tiempoMinutos;
            this.formato = formato;
        }

        public String getId() { return id; }
        public String getNombreAsset() { return nombreAsset; }
        public int getTiempoMinutos() { return tiempoMinutos; }
        public String getFormato() { return formato; }

        @Override
        public String toString() {
            return "[" + id + "] Asset: " + nombreAsset + " | Tiempo: " + tiempoMinutos + " min | Formato: " + formato;
        }
    }

    // Modelo para Lista (Catálogo)
    public static class ElementoCatalogo {
        private String id;
        private String nombre;
        private String tipo;
        private int nivel;
        private boolean activo;

        public ElementoCatalogo(String id, String nombre, String tipo, int nivel, boolean activo) {
            this.id = id;
            this.nombre = nombre;
            this.tipo = tipo;
            this.nivel = nivel;
            this.activo = activo;
        }

        public String getId() { return id; }
        public String getNombre() { return nombre; }
        public void setNombre(String nombre) { this.nombre = nombre; }
        public String getTipo() { return tipo; }
        public void setTipo(String tipo) { this.tipo = tipo; }
        public int getNivel() { return nivel; }
        public void setNivel(int nivel) { this.nivel = nivel; }
        public boolean isActivo() { return activo; }
        public void setActivo(boolean activo) { this.activo = activo; }

        @Override
        public String toString() {
            return "[" + id + "] " + nombre + " (" + tipo + ") - Nivel: " + nivel + " | Estado: " + (activo ? "Activo" : "Inactivo");
        }
    }

